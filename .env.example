# === Supabase (create a free project at https://supabase.com) ===
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key (server-only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# === Anthropic (https://console.anthropic.com) ===
# Used for card scanning (vision) and the in-app deck builder
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for scanning + deck building
ANTHROPIC_MODEL=claude-opus-5

# === Pokemon TCG API (optional but recommended: https://dev.pokemontcg.io) ===
# Raises rate limits for card lookups. Works without it, but slower limits.
POKEMONTCG_API_KEY=

# === App ===
# The public URL of the deployed app (used in magic-link redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
